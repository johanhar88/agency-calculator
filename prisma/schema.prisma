generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tabel Pelanggan
model Customer {
  id        String    @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  projects  Project[] // Relasi 1 Customer punya banyak Project
  createdAt DateTime  @default(now())
}

// Tabel Proyek Web
model Project {
  id              String   @id @default(cuid())
  name            String
  
  // Parameter Baru
  webType         String   // e.g., "Company Profile", "E-Commerce", "SaaS"
  pages           Int
  designTier      String   // e.g., "Template", "Custom", "Premium"
  cmsTier         String   // e.g., "Tanpa CMS", "Basic CMS", "Custom Admin"
  paymentGateway  Boolean  @default(false)
  apiIntegration  Boolean  @default(false)
  securityTier    String   // e.g., "Standard", "Advanced"
  languages       Int      // Jumlah bahasa (1, 2, dll)
  hostingTier     String   // e.g., "Shared", "Cloud VPS", "Dedicated"
  
  totalPrice      Float
  
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  
  createdAt       DateTime @default(now())
}

// Tabel Master Harga
model PricingConfig {
  id                 Int      @id @default(1)
  
  // Base Price
  landingPage        Float    @default(1500000)
  companyProfile     Float    @default(3500000)
  eCommerce          Float    @default(8000000)
  webApp             Float    @default(15000000)
  
  // Halaman
  pricePerPage       Float    @default(400000)
  
  // Desain
  designCustom       Float    @default(2500000)
  designPremium      Float    @default(6000000)
  
  // CMS
  cmsBasic           Float    @default(2000000)
  cmsCustom          Float    @default(6500000)
  
  // Addons
  paymentGateway     Float    @default(3000000)
  apiIntegration     Float    @default(4000000)
  langMultiplier     Float    @default(1500000) // Harga per bahasa tambahan
  securityAdvanced   Float    @default(3500000)
  
  // Hosting
  hostingShared      Float    @default(750000)
  hostingVPS         Float    @default(3000000)
  hostingDedicated   Float    @default(10000000)
  
  updatedAt          DateTime @updatedAt
}